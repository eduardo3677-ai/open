{
  "$schema": "https://opencode.ai/config.json",
  "model": "azure/zai-org--glm-47-fp8",
  "small_model": "azure/zai-org--glm-47-fp8",
  "shell": "/bin/bash",
  "logLevel": "WARN",
  "share": "manual",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2
  },
  "provider": {
    "azure": {
      "npm": "@ai-sdk/openai",
      "name": "Azure",
      "env": [
        "DASHSCOPE_API_KEY"
      ],
      "options": {
        "baseURL": "https://eduardob-9053-resource.services.ai.azure.com/openai/v1",
        "apiKey": "{env:DASHSCOPE_API_KEY}",
        "timeout": 120000,
        "maxRetries": 5
      },
      "models": {
        "zai-org--glm-47-fp8": {
          "name": "zai-org--glm-47-fp8",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "options": {
            "temperature": 0.6,
            "max_completion_tokens": 4098,
            "top_p": 1
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "external_directory": "allow"
  }
}
