{
  "$schema": "https://opencode.ai/config.json",
  "model": "azure/zai-org--glm-47-fp8",
  "shell": "/bin/bash",
  "logLevel": "WARN",
  "share": "manual",
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2
  },
  "provider": {
    "azure": {
      "npm": "@ai-sdk/openai",
      "name": "Azure",
      "env": [
        "DASHSCOPE_API_KEY"
      ],
      "options": {
        "baseURL": "https://eduardob-9053-resource.services.ai.azure.com/openai/v1",
        "apiKey": "{env:DASHSCOPE_API_KEY}",
        "timeout": 60000,
        "maxRetries": 2
      },
      "models": {
        "zai-org--glm-47-fp8": {
          "name": "zai-org--glm-47-fp8",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "options": {
            "temperature": 0.6,
            "max_completion_tokens": 4098,
            "top_p": 1
          }
        }
      }
    }
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "experimental": {
    "primary_tools": ["edit", "bash"],
    "mcp_timeout": 30000,
    "batch_tool": true,
    "continue_loop_on_deny": true
  },
  "permission": {
    "edit": "allow",
    "bash": {"git *": "allow", "*": "allow"},
    "external_directory": {"~/projects/**": "allow", "*": "allow"}
  }
}
