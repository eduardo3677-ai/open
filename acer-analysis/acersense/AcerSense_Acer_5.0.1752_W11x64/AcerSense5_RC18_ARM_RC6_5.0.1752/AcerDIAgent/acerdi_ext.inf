; Next-Gen x86
%ADIExtensionDisc% = ADIExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_11031025 ; Aspire
%ADIExtensionDisc% = ADIExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_11041025 ; Swift
%ADIExtensionDisc% = ADIExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_11051025 ; TravelMate
%ADIExtensionDisc% = ADIExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_11061025 ; Extensa

; Next-Gen AMD
