[Version]
Signature = "$WINDOWS NT$"
Class = Extension
ClassGuid = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider = %ManufacturerName%
ExtensionId = {b9c0a3fd-da71-444e-b20d-2512e53ba30f}
CatalogFile = acercc_ext.cat
DriverVer = 05/21/2024,1.2.16.1016
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = ACCExtension, NTamd64.10.0...22000

[ACCExtension.NTamd64.10.0...22000]
%ACCExtensionDisc% = ACCExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_10031025 ; Aspire
%ACCExtensionDisc% = ACCExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_10041025 ; Swift
%ACCExtensionDisc% = ACCExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_10051025 ; TravelMate
%ACCExtensionDisc% = ACCExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_10061025 ; Extensa

; Next-Gen x86
%ACCExtensionDisc% = ACCExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_11031025 ; Aspire
%ACCExtensionDisc% = ACCExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_11041025 ; Swift
%ACCExtensionDisc% = ACCExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_11051025 ; TravelMate
%ACCExtensionDisc% = ACCExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_11061025 ; Extensa

; Next-Gen AMD
%ACCExtensionDisc% = ACCExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_13031025 ; Aspire
%ACCExtensionDisc% = ACCExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_13041025 ; Swift
%ACCExtensionDisc% = ACCExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_13051025 ; TravelMate
%ACCExtensionDisc% = ACCExtension_Install, ACPI\VEN_1025&DEV_165F&SUBSYS_13061025 ; Extensa

[ACCExtension_Install.NT]
; Empty

[ACCExtension_Install.NT.HW]
AddReg = ACCExtension_AddReg

[ACCExtension_AddReg]
; Empty

[ACCExtension_Install.NT.Components]
AddComponent = ACC_DCHU_component,,ACCExtension_ComponentInstall

[ACCExtension_ComponentInstall]
ComponentIds=SWComp_AcerCareCenterDriver

[Strings]
ManufacturerName = "Acer Incorporated"
ACCExtensionDisc = "Acer Care Center Extension Disk"
